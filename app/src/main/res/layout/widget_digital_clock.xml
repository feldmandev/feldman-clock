<?xml version="1.0" encoding="utf-8"?>
<!--
    Digital clock widget. Carries both the one-line time and the stacked hour/minute; the provider
    shows whichever the layout mode calls for and hides the rest.

    The TextClock views exist so the widget picker's generated preview has something to draw. At
    runtime they are replaced by bitmaps in the Feldman font - see ClockWidgetRenderer.

    SPDX-License-Identifier: GPL-3.0-only
-->

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/digital_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/material_you_vertical_digital_widget_background"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingHorizontal="6dp"
    android:paddingVertical="4dp">

    <TextClock
        android:id="@+id/digital_widget_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="@font/feldman_rounded"
        android:format12Hour="EEE, MMM d"
        android:format24Hour="EEE, MMM d"
        android:maxLines="1"
        android:textColor="@color/widget_text_color"
        android:textSize="13sp" />

    <ImageView
        android:id="@+id/digital_widget_date_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        android:visibility="gone" />

    <!-- One-line time. -->
    <TextClock
        android:id="@+id/digital_widget_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/feldman_rounded"
        android:format12Hour="hh:mm"
        android:format24Hour="HH:mm"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/vertical_digital_widget_minute_color"
        android:textSize="44sp" />

    <ImageView
        android:id="@+id/digital_widget_time_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        android:visibility="gone" />

    <!-- Stacked hour and minute, shown instead of the one-line time. -->
    <TextClock
        android:id="@+id/digital_widget_hour"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/feldman_rounded"
        android:format12Hour="hh"
        android:format24Hour="HH"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/vertical_digital_widget_hour_color"
        android:textSize="52sp"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/digital_widget_hour_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        android:visibility="gone" />

    <TextClock
        android:id="@+id/digital_widget_minute"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/feldman_rounded"
        android:format12Hour="mm"
        android:format24Hour="mm"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/vertical_digital_widget_minute_color"
        android:textSize="52sp"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/digital_widget_minute_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/digital_widget_next_alarm_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/digital_widget_next_alarm_icon"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginEnd="4dp"
            android:contentDescription="@string/next_alarm_widget"
            android:src="@drawable/ic_tab_alarm_static"
            android:tint="@color/next_alarm_widget_alarm_color" />

        <TextView
            android:id="@+id/digital_widget_next_alarm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/feldman_rounded"
            android:maxLines="1"
            android:textColor="@color/next_alarm_widget_alarm_color"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/digital_widget_next_alarm_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
