# Copy this file to `keystore.properties` and fill in your own values.
# `keystore.properties` is gitignored and must never be committed.
#
# Every key below can alternatively be supplied as an environment variable of the
# same name, which is what CI should do.

# --- Release signing -------------------------------------------------------
# Absolute path to your keystore, or a path relative to the repository root.
# Omit STORE_FILE entirely to build an unsigned release (useful for contributors).
STORE_FILE=/absolute/path/to/your.jks
STORE_PASSWORD=
KEY_ALIAS=
KEY_PASSWORD=
